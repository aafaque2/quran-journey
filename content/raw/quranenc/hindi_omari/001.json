{"result":[{"id":"1","sura":"1","aya":"1","arabic_text":"\u0628\u0650\u0633\u06e1\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650","translation":"\u0905\u0932\u094d\u0932\u093e\u0939 \u0915\u0947 \u0928\u093e\u092e \u0938\u0947, \u091c\u094b \u0905\u0924\u094d\u092f\u0902\u0924 \u0926\u092f\u093e\u0935\u093e\u0928\u094d, \u0905\u0938\u0940\u092e \u0926\u092f\u093e \u0935\u093e\u0932\u093e \u0939\u0948\u0964","footnotes":""},{"id":"2","sura":"1","aya":"2","arabic_text":"\u0671\u0644\u06e1\u062d\u064e\u0645\u06e1\u062f\u064f \u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0631\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"\u0939\u0930 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u0940 \u092a\u094d\u0930\u0936\u0902\u0938\u093e \u0909\u0938 \u0905\u0932\u094d\u0932\u093e\u0939[1] \u0915\u0947 \u0932\u093f\u090f \u0939\u0948, \u091c\u094b \u0938\u093e\u0930\u0947 \u0938\u0902\u0938\u093e\u0930\u094b\u0902 \u0915\u093e \u092a\u093e\u0932\u0928\u0939\u093e\u0930[2] \u0939\u0948\u0964","footnotes":"[1] '\u0905\u0932\u094d\u0932\u093e\u0939' \u0915\u093e \u0905\u0930\u094d\u0925 '\u0939\u093c\u0915\u093c\u0940\u0915\u093c\u0940 \u092a\u0942\u091c\u094d\u092f' \u0939\u0948\u0964 \u091c\u094b \u0938\u0902\u0938\u093e\u0930 \u0915\u0947 \u0930\u091a\u092f\u093f\u0924\u093e, \u0935\u093f\u0927\u093e\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u0939\u0948\u0964\n[2] '\u092a\u093e\u0932\u0928\u0939\u093e\u0930' \u0939\u094b\u0928\u0947 \u0915\u093e \u0905\u0930\u094d\u0925 \u092f\u0939 \u0939\u0948 \u0915\u093f \u091c\u093f\u0938 \u0928\u0947 \u0907\u0938 \u0938\u0902\u0938\u093e\u0930 \u0915\u0940 \u0930\u091a\u0928\u093e \u0915\u0930\u0915\u0947 \u0907\u0938\u0915\u0947 \u092a\u094d\u0930\u0924\u093f\u092a\u093e\u0932\u0928 \u0915\u0940 \u0910\u0938\u0940 \u0935\u093f\u091a\u093f\u0924\u094d\u0930 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e \u0915\u0940 \u0939\u0948 \u0915\u093f \u0938\u092d\u0940 \u0915\u094b \u0905\u092a\u0928\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u094d\u0924\u093e \u0924\u0925\u093e \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0938\u092c \u0915\u0941\u091b \u092e\u093f\u0932 \u0930\u0939\u093e \u0939\u0948\u0964 \u092f\u0939 \u0938\u0902\u0938\u093e\u0930 \u0915\u093e \u092a\u0942\u0930\u093e \u0915\u093e\u0930\u094d\u092f, \u0938\u0942\u0930\u094d\u092f, \u0935\u093e\u092f\u0941, \u091c\u0932, \u0927\u0930\u0924\u0940 \u0938\u092c \u091c\u0940\u0935\u0928 \u0915\u0940 \u0930\u0915\u094d\u0937\u093e \u090f\u0935\u0902 \u091c\u0940\u0935\u0928 \u0915\u0940 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092f\u094b\u0917\u094d\u092f\u0924\u093e \u0915\u0940 \u0930\u0916\u0935\u093e\u0932\u0940 \u092e\u0947\u0902 \u0932\u0917\u0947 \u0939\u0941\u090f \u0939\u0948\u0902\u0964 \u0907\u0938\u0938\u0947 \u0938\u0924\u094d\u092f \u092a\u0942\u091c\u094d\u092f \u0915\u093e \u092a\u0930\u093f\u091a\u092f \u090f\u0935\u0902 \u091c\u094d\u091e\u093e\u0928 \u0939\u094b\u0924\u093e \u0939\u0948\u0964"},{"id":"3","sura":"1","aya":"3","arabic_text":"\u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650","translation":"\u091c\u094b \u0905\u0924\u094d\u092f\u0902\u0924 \u0926\u092f\u093e\u0935\u093e\u0928\u094d, \u0905\u0938\u0940\u092e \u0926\u092f\u093e \u0935\u093e\u0932\u093e[3] \u0939\u0948\u0964","footnotes":"[3] \u0905\u0930\u094d\u0925\u093e\u0924 \u0935\u0939 \u0938\u0902\u0938\u093e\u0930 \u0915\u0940 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e \u090f\u0935\u0902 \u0930\u0915\u094d\u0937\u093e \u0905\u092a\u0928\u0940 \u0905\u092a\u093e\u0930 \u0926\u092f\u093e \u0938\u0947 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964 \u0905\u0924\u0903 \u092a\u094d\u0930\u0936\u0902\u0938\u093e \u090f\u0935\u0902 \u092a\u0942\u091c\u093e \u0915\u0947 \u092f\u094b\u0917\u094d\u092f \u092d\u0940 \u092e\u093e\u0924\u094d\u0930 \u0935\u0939\u0940 \u0939\u0948\u0964"},{"id":"4","sura":"1","aya":"4","arabic_text":"\u0645\u064e\u0670\u0644\u0650\u0643\u0650 \u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"\u091c\u094b \u092c\u0926\u0932\u0947[4] \u0915\u0947 \u0926\u093f\u0928 \u0915\u093e \u092e\u093e\u0932\u093f\u0915 \u0939\u0948\u0964","footnotes":"[4] \u092c\u0926\u0932\u0947 \u0915\u0947 \u0926\u093f\u0928 \u0938\u0947 \u0905\u092d\u093f\u092a\u094d\u0930\u093e\u092f \u092a\u094d\u0930\u0932\u092f \u0915\u093e \u0926\u093f\u0928 \u0939\u0948\u0964 \u0906\u092f\u0924 \u0915\u093e \u092d\u093e\u0935\u093e\u0930\u094d\u0925 \u092f\u0939 \u0939\u0948 \u0915\u093f \u0938\u0924\u094d\u092f \u0927\u0930\u094d\u092e \u092c\u0926\u0932\u0947 \u0915\u0947 \u0928\u093f\u092f\u092e \u092a\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0939\u0948\u0964 \u0905\u0930\u094d\u0925\u093e\u0924 \u091c\u094b \u091c\u0948\u0938\u093e \u0915\u0930\u0947\u0917\u093e \u0935\u0948\u0938\u093e \u092d\u0930\u0947\u0917\u093e\u0964 \u091c\u0948\u0938\u0947 \u0915\u094b\u0908 \u091c\u094c \u092c\u094b\u0915\u0930 \u0917\u0947\u0939\u0942\u0901 \u0915\u0940, \u0924\u0925\u093e \u0906\u0917 \u092e\u0947\u0902 \u0915\u0942\u0926\u0915\u0930 \u0936\u0940\u0924\u0932 \u0939\u094b\u0928\u0947 \u0915\u0940 \u0906\u0936\u093e \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u093e, \u0910\u0938\u0947 \u0939\u0940 \u092d\u0932\u0947-\u092c\u0941\u0930\u0947 \u0915\u0930\u094d\u092e\u094b\u0902 \u0915\u093e \u092d\u0940 \u0905\u092a\u0928\u093e \u0938\u094d\u0935\u092d\u093e\u0935\u093f\u0915 \u0917\u0941\u0923 \u0914\u0930 \u092a\u094d\u0930\u092d\u093e\u0935 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u092b\u093f\u0930 \u0938\u0902\u0938\u093e\u0930 \u092e\u0947\u0902 \u092d\u0940 \u0915\u0941\u0915\u0930\u094d\u092e\u094b\u0902 \u0915\u093e \u0926\u0941\u0937\u094d\u092a\u0930\u093f\u0923\u093e\u092e \u0915\u092d\u0940-\u0915\u092d\u0940 \u0926\u0947\u0916\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092a\u0930\u0902\u0924\u0941 \u092f\u0939 \u092d\u0940 \u0926\u0947\u0916\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0926\u0941\u0930\u093e\u091a\u093e\u0930\u0940 \u0914\u0930 \u0905\u0924\u094d\u092f\u093e\u091a\u093e\u0930\u0940 \u0938\u0941\u0916\u0940 \u091c\u0940\u0935\u0928 \u0928\u093f\u0930\u094d\u0935\u093e\u0939 \u0915\u0930 \u0932\u0947\u0924\u093e \u0939\u0948, \u0914\u0930 \u0909\u0938\u0915\u0940 \u092a\u0915\u0921\u093c \u0907\u0938 \u0938\u0902\u0938\u093e\u0930 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940\u0964 \u0907\u0938\u0932\u093f\u090f \u0928\u094d\u092f\u093e\u092f \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0926\u093f\u0928 \u0905\u0935\u0936\u094d\u092f \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964 \u0909\u0938\u0940 \u0915\u093e \u0928\u093e\u092e '\u0915\u093c\u093f\u092f\u093e\u092e\u0924' (\u092a\u094d\u0930\u0932\u092f \u0915\u093e \u0926\u093f\u0928) \u0939\u0948\u0964 \"\u092c\u0926\u0932\u0947 \u0915\u0947 \u0926\u093f\u0928 \u0915\u093e \u092e\u093e\u0932\u093f\u0915\" \u0939\u094b\u0928\u0947 \u0915\u093e \u0905\u0930\u094d\u0925 \u092f\u0939 \u0939\u0948 \u0915\u093f \u0938\u0902\u0938\u093e\u0930 \u092e\u0947\u0902 \u092d\u0940 \u0909\u0938\u0928\u0947 \u0907\u0928\u0938\u093e\u0928\u094b\u0902 \u0915\u094b \u0905\u0927\u093f\u0915\u093e\u0930 \u0914\u0930 \u0930\u093e\u091c\u094d\u092f \u0926\u093f\u090f \u0939\u0948\u0902\u0964 \u092a\u0930\u0902\u0924\u0941 \u092a\u094d\u0930\u0932\u092f \u0915\u0947 \u0926\u093f\u0928 \u0938\u092c \u0905\u0927\u093f\u0915\u093e\u0930 \u0909\u0938\u0940 \u0915\u093e \u0930\u0939\u0947\u0917\u093e\u0964 \u0914\u0930 \u0935\u0939\u0940 \u0928\u094d\u092f\u093e\u092f\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u092c\u0915\u094b \u0909\u0928\u0915\u0947 \u0915\u0930\u094d\u092e\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u0924\u093f\u092b\u0932 \u0926\u0947\u0917\u093e\u0964"},{"id":"5","sura":"1","aya":"5","arabic_text":"\u0625\u0650\u064a\u0651\u064e\u0627\u0643\u064e \u0646\u064e\u0639\u06e1\u0628\u064f\u062f\u064f \u0648\u064e\u0625\u0650\u064a\u0651\u064e\u0627\u0643\u064e \u0646\u064e\u0633\u06e1\u062a\u064e\u0639\u0650\u064a\u0646\u064f","translation":"(\u0910 \u0905\u0932\u094d\u0932\u093e\u0939!) \u0939\u092e \u0924\u0947\u0930\u0940 \u0939\u0940 \u0907\u092c\u093e\u0926\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0924\u0941\u091d\u0940 \u0938\u0947 \u0938\u0939\u093e\u092f\u0924\u093e \u092e\u093e\u0901\u0917\u0924\u0947[5] \u0939\u0948\u0902\u0964","footnotes":"[5] \u0907\u0928 \u0906\u092f\u0924\u094b\u0902 \u092e\u0947\u0902 \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928\u093e \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092e\u093e\u0924\u094d\u0930 \u0905\u0932\u094d\u0932\u093e\u0939 \u0939\u0940 \u0915\u0940 \u092a\u0942\u091c\u093e \u0914\u0930 \u0909\u0938\u0940 \u0915\u094b \u0938\u0939\u093e\u092f\u0924\u093e\u0930\u094d\u0925 \u0917\u0941\u0939\u093e\u0930\u0928\u0947 \u0915\u0940 \u0936\u093f\u0915\u094d\u0937\u093e \u0926\u0940 \u0917\u0908 \u0939\u0948\u0964 \u0907\u0938\u094d\u0932\u093e\u092e \u0915\u0940 \u092a\u0930\u093f\u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0907\u0938\u0940 \u0915\u093e \u0928\u093e\u092e '\u0924\u094c\u0939\u093c\u0940\u0926' (\u090f\u0915\u0947\u0936\u094d\u0935\u0930\u0935\u093e\u0926) \u0939\u0948, \u091c\u094b \u0938\u0924\u094d\u092f \u0927\u0930\u094d\u092e \u0915\u093e \u0906\u0927\u093e\u0930 \u0939\u0948\u0964 \u0914\u0930 \u0905\u0932\u094d\u0932\u093e\u0939 \u0915\u0947 \u0938\u093f\u0935\u093e \u092f\u093e \u0909\u0938\u0915\u0947 \u0938\u093e\u0925 \u0915\u093f\u0938\u0940 \u0926\u0947\u0935\u0940-\u0926\u0947\u0935\u0924\u093e \u0906\u0926\u093f \u0915\u094b \u092a\u0941\u0915\u093e\u0930\u0928\u093e, \u0909\u0938\u0915\u0940 \u092a\u0942\u091c\u093e \u0915\u0930\u0928\u093e, \u0915\u093f\u0938\u0940 \u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u0938\u093e\u0927\u0928 \u0915\u0947 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0915\u094b \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0947 \u0932\u093f\u092f\u0947 \u0917\u0941\u0939\u093e\u0930\u0928\u093e, \u0915\u093f\u0938\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0914\u0930 \u0935\u0938\u094d\u0924\u0941 \u092e\u0947\u0902 \u0905\u0932\u094d\u0932\u093e\u0939 \u0915\u093e \u0915\u094b\u0908 \u0935\u093f\u0936\u0947\u0937 \u0917\u0941\u0923 \u092e\u093e\u0928\u0928\u093e \u0906\u0926\u093f \u090f\u0915\u0947\u0936\u094d\u0935\u0930\u0935\u093e\u0926 (\u0924\u094c\u0939\u093c\u0940\u0926) \u0915\u0947 \u0935\u093f\u0930\u0941\u0926\u094d\u0927 \u0939\u0948\u0902 \u091c\u094b \u0905\u0915\u094d\u0937\u092e\u094d\u092f \u092a\u093e\u092a \u0939\u0948\u0902\u0964 \u091c\u093f\u0938\u0915\u0947 \u0938\u093e\u0925 \u0915\u094b\u0908 \u092a\u0941\u0923\u094d\u092f \u0915\u093e \u0915\u093e\u0930\u094d\u092f \u092e\u093e\u0928\u094d\u092f \u0928\u0939\u0940\u0902\u0964"},{"id":"6","sura":"1","aya":"6","arabic_text":"\u0671\u0647\u06e1\u062f\u0650\u0646\u064e\u0627 \u0671\u0644\u0635\u0651\u0650\u0631\u064e\u0670\u0637\u064e \u0671\u0644\u06e1\u0645\u064f\u0633\u06e1\u062a\u064e\u0642\u0650\u064a\u0645\u064e","translation":"\u0939\u092e\u0947\u0902 \u0938\u0940\u0927\u0947 \u092e\u093e\u0930\u094d\u0917 \u092a\u0930 \u091a\u0932\u093e\u0964","footnotes":""},{"id":"7","sura":"1","aya":"7","arabic_text":"\u0635\u0650\u0631\u064e\u0670\u0637\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064e\u0646\u06e1\u0639\u064e\u0645\u06e1\u062a\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u063a\u064e\u064a\u06e1\u0631\u0650 \u0671\u0644\u06e1\u0645\u064e\u063a\u06e1\u0636\u064f\u0648\u0628\u0650 \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u0648\u064e\u0644\u064e\u0627 \u0671\u0644\u0636\u0651\u064e\u0627\u0653\u0644\u0651\u0650\u064a\u0646\u064e","translation":"\u0909\u0928 \u0932\u094b\u0917\u094b\u0902 \u0915\u093e \u092e\u093e\u0930\u094d\u0917, \u091c\u093f\u0928\u092a\u0930 \u0924\u0942\u0928\u0947 \u0905\u0928\u0941\u0917\u094d\u0930\u0939 \u0915\u093f\u092f\u093e\u0964[6] \u0909\u0928\u0915\u093e \u0928\u0939\u0940\u0902, \u091c\u093f\u0928\u092a\u0930 \u0924\u0947\u0930\u093e \u092a\u094d\u0930\u0915\u094b\u092a[7] \u0939\u0941\u0906 \u0914\u0930 \u0928 \u0939\u0940 \u0909\u0928\u0915\u093e, \u091c\u094b \u0917\u0941\u092e\u0930\u093e\u0939 \u0939\u0948\u0902\u0964","footnotes":"[6] \u0907\u0938 \u0906\u092f\u0924 \u092e\u0947\u0902 \u0938\u0940\u0927\u0947 \u092e\u093e\u0930\u094d\u0917 \u0915\u093e \u091a\u093f\u0939\u094d\u0928 \u092f\u0939 \u092c\u0924\u093e\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u0915\u093f \u092f\u0939 \u0909\u0928\u0915\u093e \u092e\u093e\u0930\u094d\u0917 \u0939\u0948, \u091c\u093f\u0928\u092a\u0930 \u0905\u0932\u094d\u0932\u093e\u0939 \u0915\u093e \u092a\u0941\u0930\u0938\u094d\u0915\u093e\u0930 \u0939\u0941\u0906\u0964 \u0909\u0928\u0915\u093e \u0928\u0939\u0940\u0902, \u091c\u094b \u092a\u094d\u0930\u0915\u094b\u092a\u093f\u0924 \u0939\u0941\u090f \u0914\u0930 \u0928 \u0909\u0928\u0915\u093e, \u091c\u094b \u0938\u0924\u094d\u092f \u092e\u093e\u0930\u094d\u0917 \u0938\u0947 \u092c\u0939\u0915 \u0917\u090f\u0964\n[7] '\u092a\u094d\u0930\u0915\u094b\u092a\u093f\u0924' \u0938\u0947 \u0905\u092d\u093f\u092a\u094d\u0930\u093e\u092f \u0935\u0947 \u0939\u0948\u0902, \u091c\u094b \u0938\u0924\u094d\u092f \u0927\u0930\u094d\u092e \u0915\u094b, \u091c\u093e\u0928\u0924\u0947 \u0939\u0941\u090f, \u092e\u093e\u0924\u094d\u0930 \u0905\u092d\u093f\u092e\u093e\u0928 \u0905\u0925\u0935\u093e \u0905\u092a\u0928\u0947 \u092a\u0941\u0930\u094d\u0935\u091c\u094b\u0902 \u0915\u0940 \u092a\u0930\u0902\u092a\u0930\u093e\u0917\u0924 \u092a\u094d\u0930\u0925\u093e \u0915\u0947 \u092e\u094b\u0939 \u092e\u0947\u0902 \u0905\u0925\u0935\u093e \u0905\u092a\u0928\u0940 \u092c\u0921\u093c\u093e\u0908 \u0915\u0947 \u091c\u093e\u0928\u0947 \u0915\u0947 \u092d\u092f \u0938\u0947, \u0928\u0939\u0940\u0902 \u092e\u093e\u0928\u0924\u0947\u0964 '\u0917\u0941\u092e\u0930\u093e\u0939' \u0938\u0947 \u0905\u092d\u093f\u092a\u094d\u0930\u0947\u0924 \u0935\u0947 \u0939\u0948\u0902, \u091c\u094b \u0938\u0924\u094d\u092f \u0927\u0930\u094d\u092e \u0915\u0947 \u0939\u094b\u0924\u0947 \u0939\u0941\u090f, \u0909\u0938\u0938\u0947 \u0926\u0942\u0930 \u0939\u094b \u0917\u090f \u0914\u0930 \u0926\u0947\u0935\u0940-\u0926\u0947\u0935\u0924\u093e\u0913\u0902 \u0906\u0926\u093f \u092e\u0947\u0902 \u0905\u0932\u094d\u0932\u093e\u0939 \u0915\u0947 \u0935\u093f\u0936\u0947\u0937 \u0917\u0941\u0923 \u092e\u093e\u0928\u0915\u0930 \u0909\u0928\u0915\u094b \u0930\u094b\u0917 \u0928\u093f\u0935\u093e\u0930\u0923, \u0926\u0941\u0903\u0916 \u0926\u0942\u0930 \u0915\u0930\u0928\u0947 \u0914\u0930 \u0938\u0941\u0916-\u0938\u0902\u0924\u093e\u0928 \u0906\u0926\u093f \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0917\u0941\u0939\u093e\u0930\u0928\u0947 \u0932\u0917\u0947\u0964"}]}
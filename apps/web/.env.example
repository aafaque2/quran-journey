# Copy to .env.local for local settings. Never commit real secrets.

# Public address of the site, no trailing slash (canonical URLs, Open Graph, sitemap).
# NEXT_PUBLIC_SITE_URL=https://example.org

# Which Parts the app shows: drafts | reviewed | published
#   drafts    = everything, each with its review-status banner (local preview / closed pilot)
#   reviewed  = EDITOR_REVIEW and beyond   (default in production)
#   published = PUBLISHED only
# Set it at BUILD time: Parts are pre-rendered.
# CONTENT_VISIBILITY=reviewed

# Issue reports. Without these, reports go to apps/web/.data/reports.jsonl (local / single server).
# On serverless hosts (e.g. Vercel) set both, after running supabase/migrations/0001_reports.sql.
# The service-role key is secret: server-side only, never NEXT_PUBLIC_.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Internal review tool at /internal-review (validation results, every claim, issue reports).
# In production it ALSO needs REVIEW_PASSWORD (HTTP Basic auth, any user name); without it the page stays off.
# INTERNAL_REVIEW=true
# REVIEW_PASSWORD=

# Optional per-verse recitation audio for Story Mode (use a source you are licensed to use).
# Placeholders: {surah} {ayah} {surah3} {ayah3}  (the "3" forms are zero-padded, e.g. 002005)
# NEXT_PUBLIC_RECITATION_URL_TEMPLATE=

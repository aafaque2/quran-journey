# Copy to .env.local for local settings. Never commit real secrets.

# Which Parts the app shows: drafts | reviewed | published
#   drafts    = everything, each with its review-status banner (local preview / closed pilot)
#   reviewed  = EDITOR_REVIEW and beyond   (default in production)
#   published = PUBLISHED only
# CONTENT_VISIBILITY=reviewed

# Internal review tool at /internal-review. Local use only; never enable on a public deployment.
# INTERNAL_REVIEW=true

# Optional per-verse recitation audio for Story Mode (use a source you are licensed to use).
# Placeholders: {surah} {ayah} {surah3} {ayah3}  (the "3" forms are zero-padded, e.g. 002005)
# NEXT_PUBLIC_RECITATION_URL_TEMPLATE=
